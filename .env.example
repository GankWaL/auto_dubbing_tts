# (선택) Typecast API 키 — 설정하면 감정 지원 Typecast 음성이 추가됨 (유료 크레딧 소모)
# 발급: https://studio.typecast.ai/developers
TYPECAST_API_KEY=

# (선택) Google Cloud TTS API 키 — 설정하면 한국어 Neural2 음성이 추가됨
# 월 무료 한도(100만 자)의 95%까지만 사용하고 초과 시 Edge TTS로 자동 전환
GOOGLE_TTS_API_KEY=

# (선택) 커스텀 목소리(GPT-SoVITS) 폴더 위치 — my_voice, my_voice_models 가 있는 폴더.
# 비우면 이 저장소 루트. 디스코드 봇에서 학습한 목소리를 그대로 쓰려면 그 저장소 경로를 지정.
# 예: MY_VOICE_ROOT=C:\Users\me\vscode\discord_bot_chzzk_tts
MY_VOICE_ROOT=

# (선택) 커스텀 TTS 서버 주소·포트. 디스코드 봇이 띄운 서버를 같이 쓰면 그대로 두면 된다.
CUSTOM_TTS_URL=http://127.0.0.1:51770
CUSTOM_TTS_PORT=51770

# (선택) 네이버 클라우드 CLOVA OCR API — OCR 엔진을 "CLOVA OCR API" 로 고를 때 필요 (호출당 과금)
# 네이버 클라우드 플랫폼 → CLOVA OCR → 도메인 생성(General) → API Gateway 연동 → Invoke URL / Secret Key
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
